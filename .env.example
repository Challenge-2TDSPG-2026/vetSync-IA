GEMINI_API_KEY=your_gemini_api_key_here

# Configurações do Banco de Dados Oracle (Existente)
# Formato comum: oracle+oracledb://usuario:senha@host:porta/?service_name=nome_do_servico
ORACLE_DB_URL=oracle+oracledb://usuario_oracle:senha_oracle@host_do_banco:1521/?service_name=NOME_SERVICO

# Configurações de Autenticação (Sistema Externo)
# Se você validar o token via chave pública/secreta:
# AUTH_JWT_SECRET=sua_chave_secreta_aqui
# Se você validar batendo em outra API:
# EXTERNAL_AUTH_URL=https://api.externa.com/v1/auth/validate
