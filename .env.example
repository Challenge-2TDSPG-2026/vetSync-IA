# Chave de API do Google Gemini (obrigatória para os modelos generativos)
GEMINI_API_KEY=sua_chave_gemini_aqui

# URL de conexão com o banco Oracle (ex: oracle+oracledb://usuario:senha@host:porta/?service_name=ORCL)
ORACLE_DB_URL=oracle+oracledb://RMXXXXXX:senha@oracle.fiap.com.br:1521/?service_name=ORCL

# Segredo de assinatura dos tokens JWT compartilhados com o backend. Para a
# integração local, use o mesmo valor de JWT_SECRET configurado no Java.
AUTH_JWT_SECRET=seu_jwt_secret_aqui

# Em dev, a SIA aceita um Bearer real e o valida com AUTH_JWT_SECRET. Sem
# Bearer, os endpoints isolados usam o usuário de desenvolvimento.
APP_ENV=dev

# URL pública do backend Java VetSync. A SIA encaminha o Bearer do tutor para
# consultar os catálogos e criar o evento por POST /eventos.
JAVA_API_BASE_URL=https://sua-api-java.example.com
